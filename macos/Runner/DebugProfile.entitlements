<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Исходящие запросы: без этого sandbox молча рвёт соединение с TMDB. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Keychain для flutter_secure_storage требует настоящей Team ID:
	     без неё локальная ad-hoc подпись становится невалидной и система
	     убивает процесс. На macOS приложение работает без секретного
	     хранилища — токен остаётся в памяти. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
